<% layout("/layouts/boilerplate") %>

  <% const isHost=currUser && listing.owner && String(currUser._id)===String(listing.owner._id); %>

    <style>
      .chat-page {
        max-width: 500px;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family: 'Inter', sans-serif;
      }

      .chat-header {
        background: linear-gradient(135deg, #ff385c, #ff6584);
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 1.2rem 1.5rem;
      }

      .chat-header h2 {
        margin: 0;
        font-size: 1.2rem;
      }

      .chat-header small {
        opacity: .85;
      }

      .chat-box {
        border: 1px solid #eee;
        border-top: none;
        height: 310px;
        overflow-y: auto;
        padding: 1rem;
        background: #fafafa;
        display: flex;
        flex-direction: column;
        gap: .6rem;
        scroll-behavior: smooth;
      }

      .chat-bubble {
        max-width: 72%;
        padding: .55rem 1rem;
        border-radius: 18px;
        font-size: .92rem;
        line-height: 1.45;
        word-break: break-word;
        position: relative;
      }

      .chat-bubble.mine {
        background: #ff385c;
        color: #fff;
        align-self: flex-end;
        border-bottom-right-radius: 4px;
      }

      .chat-bubble.other {
        background: #fff;
        border: 1px solid #e0e0e0;
        align-self: flex-start;
        border-bottom-left-radius: 4px;
      }

      .btn-send {
        background: #ff385c;
        color: #fff;
        border: none;
        padding: 0.6rem 1.4rem;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.2s ease;
      }

      .btn-send:hover {
        background: #e31c5f;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(255, 56, 92, 0.2);
      }

      .btn-offer {
        background: #f7f7f7;
        color: #222;
        border: 1px solid #ddd;
        padding: 0.6rem 1.4rem;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.2s ease;
      }

      .btn-offer:hover {
        background: #efefef;
        border-color: #bbb;
        transform: translateY(-1px);
      }

      /* Style for Accept/Reject specific buttons in cards */
      .chat-offer-card .btn-send {
        background: #22c55e !important;
      }

      .chat-offer-card .btn-send:hover {
        background: #16a34a !important;
      }

      .chat-offer-card .btn-offer {
        background: #ef4444 !important;
        color: #fff !important;
        border: none !important;
      }

      .chat-offer-card .btn-offer:hover {
        background: #dc2626 !important;
        color: #fff !important;
      }

      .chat-bubble .time {
        font-size: .7rem;
        opacity: .7;
        margin-top: .2rem;
        display: block;
      }

      .chat-offer-card {
        background: linear-gradient(135deg, #fff8e1, #fff3cd);
        border: 2px solid #ffc107;
        border-radius: 14px;
        padding: 1rem;
        margin: .4rem 0;
        max-width: 82%;
      }

      .chat-offer-card.mine {
        align-self: flex-end;
      }

      .btn-back-chat {
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.2s ease;
      }

      .btn-back-chat:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: translateX(-2px);
        color: #fff;
      }

      .chat-header {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .chat-footer {
        border: 1px solid #eee;
        border-top: 2px solid #ff385c;
        border-radius: 0 0 16px 16px;
        padding: .8rem 1rem;
        background: #fff;
        display: flex;
        gap: .6rem;
        align-items: center;
        flex-wrap: wrap;
      }

      .chat-footer input {
        flex: 1;
        border: 1px solid #ddd;
        border-radius: 50px;
        padding: .5rem 1rem;
        font-size: .92rem;
        outline: none;
      }

      .chat-footer input:focus {
        border-color: #ff385c;
      }

      .btn-send {
        background: #ff385c;
        color: #fff;
        border: none;
        border-radius: 50px;
        padding: .5rem 1.2rem;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
      }

      .btn-send:hover {
        background: #e0214a;
      }

      .btn-offer {
        background: #fff3cd;
        color: #856404;
        border: 1px solid #ffc107;
        border-radius: 50px;
        padding: .5rem 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
        display: flex;
        align-items: center;
        gap: .4rem;
      }

      .btn-offer:hover {
        background: #ffe69c;
      }

      .offer-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6);
        display: none;
        justify-content: center;
        align-items: flex-start;
        /* Start from top to allow scrolling */
        z-index: 10000;
        backdrop-filter: blur(5px);
        padding: 2rem 1rem;
        /* Space for scrolling */
        overflow-y: auto;
        /* Scroll the overlay, not the modal */
      }

      .offer-modal-overlay.show {
        display: flex !important;
      }

      .offer-modal {
        background: #fff;
        border-radius: 20px;
        padding: 1.5rem;
        max-width: 460px;
        width: 95%;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.12);
        animation: slideUp .4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        margin-bottom: 2rem;
      }

      .offer-modal h3 {
        margin-bottom: 1rem;
        font-size: 1.5rem;
        color: #ff385c;
        font-weight: 700;
        text-align: center;
      }

      .offer-modal label {
        display: block;
        text-align: left;
        font-weight: 600;
        margin-bottom: 0.4rem;
        color: #484848;
        font-size: 0.9rem;
      }

      .offer-modal input {
        width: 100%;
        padding: 0.7rem 1rem;
        margin-bottom: 1rem;
        border: 1px solid #ddd;
        border-radius: 12px;
        font-size: 1rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
      }

      .offer-modal input:focus {
        border-color: #ff385c;
        box-shadow: 0 0 0 4px rgba(255, 56, 92, 0.1);
      }

      .btn-group-modal {
        display: flex;
        gap: 0.8rem;
        margin-top: 1rem;
      }

      .accepted-banner {
        display: none;
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
        border-radius: 12px;
        padding: 1.2rem 2.5rem 1.2rem 1.2rem;
        /* Added extra right padding for X */
        margin: 10px 15px;
        position: sticky;
        top: 10px;
        z-index: 100;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        animation: slideDown 0.4s ease-out;
      }

      .accepted-banner .btn-close {
        top: 12px !important;
        right: 12px !important;
        opacity: 0.7;
        transition: 0.2s;
      }

      .accepted-banner .btn-close:hover {
        opacity: 1;
      }

      .banner-flex {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
      }

      .accepted-banner.show {
        display: block;
      }

      @keyframes slideDown {
        from {
          transform: translateY(-20px);
          opacity: 0;
        }

        to {
          transform: translateY(0);
          opacity: 1;
        }
      }

      @media (max-width: 576px) {
        .chat-page {
          margin: 15px auto;
          max-width: 95%;
          padding: 0;
          border-radius: 16px;
          overflow: hidden;
          box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        .chat-header {
          border-radius: 0;
          padding: 1rem;
        }

        .chat-box {
          height: calc(100vh - 320px);
          min-height: 250px;
        }

        .chat-footer {
          padding: 0.6rem !important;
          gap: 0.4rem !important;
        }

        .chat-footer input {
          font-size: 0.85rem !important;
          min-width: 0 !important;
        }

        .offer-modal {
          padding: 1.5rem;
          width: 95%;
        }

        /* 📱 Mobile Horizontal Scaling (SS Format) */
        .accepted-banner {
          padding: 8px 10px !important;
          margin-bottom: 12px;
        }

        .accepted-banner .banner-flex {
          display: flex !important;
          flex-direction: row !important;
          justify-content: space-between;
          align-items: center;
          gap: 5px;
        }

        .accepted-banner h6 {
          font-size: 0.85rem !important;
        }

        .accepted-banner small {
          font-size: 0.7rem !important;
        }

        .accepted-banner .btn-send {
          padding: 5px 10px !important;
          font-size: 0.75rem !important;
          width: auto !important;
        }

        .chat-offer-card {
          padding: 10px !important;
          max-width: 95% !important;
        }

        .chat-offer-card b {
          font-size: 0.85rem !important;
        }

        .chat-offer-card .badge {
          font-size: 0.65rem !important;
          padding: 2px 6px !important;
        }

        /* Reset Cursors */
        * {
          cursor: auto !important;
        }

        button,
        a,
        .btn {
          cursor: pointer !important;
        }

        .btn-group-modal {
          flex-direction: row !important;
          gap: 0.5rem;
          display: flex;
          justify-content: center;
          align-items: stretch;
        }

        .btn-send,
        .btn-offer {
          flex: 1 !important;
          width: auto !important;
          padding: 0.6rem 0.4rem !important;
          font-size: 0.82rem !important;
          border-radius: 20px !important;
          white-space: nowrap !important;
          margin: 0 !important;
          display: flex !important;
          justify-content: center;
          align-items: center;
          height: auto;
        }

        /* Prevent host buttons in card from overflowing */
        .chat-offer-card button {
          min-width: 0 !important;
          padding: 0.4rem 0.3rem !important;
          font-size: 0.75rem !important;
        }

        #priceComparisonBox {
          padding: 0.8rem !important;
        }

        #dynamicBadgesContainer .badge {
          white-space: normal !important;
          text-align: left;
          word-break: break-word;
          max-width: 100%;
        }
      }
    </style>

    <div class="chat-page">
      <div class="chat-header">
        <a href="/listings/<%= listing._id %>" class="btn-back-chat" title="Back to Listing"
          style="width: auto; padding: 0 10px; border-radius: 20px; gap: 5px;">
          <i class="fa-solid fa-arrow-left"></i>
          <!-- <span style="font-size: 0.85rem; font-weight: 600;">Back</span> -->
        </a>
        <div>
          <h2>Chat with <%= isHost ? "Guest" : "Host" %>
          </h2>
          <small>
            <%= listing.title %>
          </small>
        </div>
      </div>

      <% if (!isHost) { %>
        <div id="acceptedBanner" class="accepted-banner <%= acceptedCheckoutUrl ? 'show' : '' %>">
          <button type="button" class="btn-close position-absolute" style="top: 8px; right: 8px; font-size: 0.65rem;"
            onclick="this.parentElement.classList.remove('show')" aria-label="Close"></button>
          <div class="banner-flex">
            <div class="text-start">
              <h6 class="mb-0 fw-bold">🎉 Proposal Accepted!</h6>
              <small class="text-muted">Book now at your negotiated price.</small>
            </div>
            <a id="checkoutLink" href="<%= acceptedCheckoutUrl || '#' %>" class="btn-send text-center"
              style="text-decoration: none;">
              Book Now
            </a>
          </div>
        </div>
        <% } %>

          <div class="chat-box" id="chatBox">
            <% if (chat && chat.messages && chat.messages.length> 0) { %>
              <% chat.messages.forEach(msg=> { %>
                <% if (msg.type==='text' ) { %>
                  <div class="chat-bubble <%= String(msg.sender._id) === String(currUser._id) ? 'mine' : 'other' %>">
                    <% if (String(msg.sender._id) !==String(currUser._id)) { %>
                      <b>
                        <%= msg.sender.username %>
                      </b><br>
                      <% } %>
                        <%= msg.text %>
                          <span class="time">
                            <%= msg.timestamp.toLocaleTimeString("en-IN", { hour: "2-digit" , minute: "2-digit" }) %>
                          </span>
                  </div>
                  <% } else if (msg.type==='offer' ) { %>
                    <div class="chat-offer-card <%= String(msg.sender._id) === String(currUser._id) ? 'mine' : '' %>"
                      id="offer-<%= msg.offerDetails.offerId %>">
                      <div class="d-flex justify-content-between align-items-center mb-1">
                        <b>
                          <%= String(msg.sender._id)===String(currUser._id) ? "My Proposal" : `Proposal from
                            ${msg.sender.username}` %>
                        </b>
                        <span
                          class="badge <%= msg.offerDetails.status === 'accepted' ? 'bg-success' : (msg.offerDetails.status === 'rejected' ? 'bg-danger' : 'bg-warning text-dark') %> rounded-pill">
                          <%= msg.offerDetails.status.charAt(0).toUpperCase() + msg.offerDetails.status.slice(1) %>
                        </span>
                      </div>
                      <div class="my-1 small">
                        💰 <b>₹<%= msg.offerDetails.price.toLocaleString("en-IN") %></b> (Total inclusive price)<br>
                        📅 <small>
                          <%= msg.offerDetails.checkIn %> → <%= msg.offerDetails.checkOut %>
                        </small>
                      </div>
                      <% if (isHost && String(msg.sender._id) !==String(currUser._id) &&
                        msg.offerDetails.status==='pending' ) { %>
                        <div style="margin-top:.6rem; display:flex; gap:.5rem;">
                          <button class="btn-send" style="padding:.35rem .9rem"
                            onclick="acceptOffer('<%= msg.offerDetails.offerId %>')">✅ Accept</button>
                          <button class="btn-offer btn-reject-custom" style="padding:.35rem .9rem"
                            onclick="rejectOffer('<%= msg.offerDetails.offerId %>')">❌ Reject</button>
                        </div>
                        <% } %>
                    </div>
                    <% } %>
                      <% }) %>
                        <% } else { %>
                          <div class="chat-bubble other">
                            <b>Host</b><br>
                            Welcome! Feel free to ask questions or make an offer. 🏠
                            <span class="time">Just now</span>
                          </div>
                          <% } %>
          </div>

          <div class="chat-footer">
            <input type="text" id="msgInput" placeholder="Type a message…" autocomplete="off" />
            <button class="btn-send" onclick="sendMessage()">Send</button>
            <% if (!isHost) { %>
              <button class="btn-offer" onclick="document.getElementById('offerOverlay').classList.add('show')">
                💰 Make an Offer
              </button>
              <% } %>
          </div>

    </div>
    </div>

    <!-- Offer Modal -->
    <div class="offer-modal-overlay" id="offerOverlay">
      <div class="offer-modal">
        <h3>💰 Make an Offer</h3>

        <div id="priceComparisonBox" class="p-2 mb-3 rounded-3"
          style="background: #f0f7ff; border: 1px solid #cce5ff; display: none;">
          <div
            class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-2 gap-2">
            <span class="text-muted small fw-medium" style="line-height: 1.2;">Standard Total <br
                class="d-none d-sm-block"><span class="small">(incl. all taxes)</span>:</span>
            <span id="actualDynamicPrice" class="fs-6 fw-bold text-primary">₹0</span>
          </div>
          <div id="dynamicBadgesContainer" class="d-flex flex-wrap gap-2 mt-1"></div>
        </div>

        <label>Your proposed total price (Inclusive of all taxes)</label>
        <input type="number" id="offerPrice" placeholder="e.g. 2500" min="1" max="10000000" required />

        <label>Check-in</label>
        <input type="date" id="offerCheckIn" required />

        <label>Check-out</label>
        <input type="date" id="offerCheckOut" required />

        <div class="btn-group-modal">
          <button class="btn-send" onclick="submitOffer()">Submit Offer</button>
          <button class="btn-offer"
            onclick="document.getElementById('offerOverlay').classList.remove('show')">Cancel</button>
        </div>
      </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
      const listingId = "<%= listing._id %>";
      const myUserId = "<%= currUser ? currUser._id : '' %>";
      const myUsername = "<%= currUser ? currUser.username : 'Guest' %>";
      const guestId = "<%= guestId %>"; // Passed from controller
      const currentUserIsHost = "<%= isHost %>" === "true";

      const socket = io();
      socket.emit("join_room", { listingId, guestId, userId: myUserId, username: myUsername });

      const chatBox = document.getElementById("chatBox");

      function scrollBottom() {
        chatBox.scrollTop = chatBox.scrollHeight;
      }
      scrollBottom();

      function addBubble({ username, message, timestamp, mine = false }) {
        const div = document.createElement("div");
        div.className = `chat-bubble ${mine ? "mine" : "other"}`;
        div.innerHTML = `${mine ? "" : `<b>${username}</b><br>`}${message}<span class="time">${timestamp}</span>`;
        chatBox.appendChild(div);
        scrollBottom();
      }

      function sendMessage() {
        const msg = document.getElementById("msgInput").value.trim();
        if (!msg) return;
        socket.emit("send_message", { listingId, guestId, message: msg, username: myUsername });
        document.getElementById("msgInput").value = "";
      }

      document.getElementById("msgInput").addEventListener("keydown", (e) => {
        if (e.key === "Enter") sendMessage();
      });

      socket.on("new_message", ({ username, message, timestamp }) => {
        addBubble({ username, message, timestamp, mine: username === myUsername });
      });

      // ── Offer Flow ──────────────────────────────────────────────────────────────
      let myActiveOfferId = null;

      // Set min dates for the inputs correctly
      const now = new Date();
      const today = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');
      const maxDate = (now.getFullYear() + 2) + '-12-31'; // Limit to 2 years in future

      const checkInInput = document.getElementById('offerCheckIn');
      const checkOutInput = document.getElementById('offerCheckOut');

      if (checkInInput) {
        checkInInput.min = today;
        checkInInput.max = maxDate;
        checkInInput.addEventListener('change', (e) => {
          checkOutInput.min = e.target.value;
          if (checkOutInput.value && checkOutInput.value < e.target.value) {
            checkOutInput.value = e.target.value;
          }
        });
      }
      if (checkOutInput) {
        checkOutInput.max = maxDate;
      }

      const MS_PER_DAY = 86400000;
      const GST_RATE = 0.18;

      // 📊 Real-time Dynamic Price Preview in Modal
      async function updateStandardTotal() {
        const checkIn = checkInInput.value;
        const checkOut = checkOutInput.value;
        const box = document.getElementById("priceComparisonBox");
        const priceSpan = document.getElementById("actualDynamicPrice");
        const badgesContainer = document.getElementById("dynamicBadgesContainer");

        if (!checkIn) {
          if (box) box.style.display = "none";
          return;
        }

        try {
          const res = await fetch(`/api/features/listings/price?listingId=${listingId}&checkIn=${checkIn}`);
          const data = await res.json();

          if (data && data.finalPrice) {
            let nights = 1;
            if (checkOut) {
              const d1 = new Date(checkIn);
              const d2 = new Date(checkOut);
              nights = Math.max(1, Math.ceil((d2 - d1) / MS_PER_DAY));
            }

            const totalStayBase = data.finalPrice * nights;
            const totalWithTax = Math.round(totalStayBase * (1 + GST_RATE));

            if (box) box.style.display = "block";
            if (priceSpan) priceSpan.textContent = `₹${totalWithTax.toLocaleString("en-IN")}`;

            if (badgesContainer) {
              badgesContainer.innerHTML = "";
              if (data.breakdown && data.breakdown.length > 0) {
                data.breakdown.forEach(badge => {
                  const span = document.createElement("span");
                  span.className = `badge bg-${badge.color || 'info'} small text-white`;
                  span.style.fontSize = "0.7rem";
                  span.style.padding = "2px 6px";
                  span.style.borderRadius = "4px";
                  span.textContent = `${badge.label} (${badge.change})`;
                  badgesContainer.appendChild(span);
                });
              }
            }
          }
        } catch (e) { console.error("Price Preview Error", e); }
      }

      if (checkInInput) {
        checkInInput.addEventListener("change", updateStandardTotal);
      }
      if (checkOutInput) {
        checkOutInput.addEventListener("change", updateStandardTotal);
      }

      function submitOffer() {
        const price = document.getElementById("offerPrice").value;
        const checkIn = document.getElementById("offerCheckIn").value;
        const checkOut = document.getElementById("offerCheckOut").value;

        if (!price || !checkIn || !checkOut) return alert("Price and dates are required.");

        const p = Number(price);
        if (isNaN(p) || p <= 0) return alert("Please enter a valid positive price.");
        if (p > 10000000) return alert("Price offer cannot exceed ₹1,00,00,000.");

        if (!checkIn || !checkOut) return alert("Please select valid check-in and check-out dates.");

        const dIn = new Date(checkIn);
        const dOut = new Date(checkOut);
        const now = new Date();
        now.setHours(0, 0, 0, 0);

        if (isNaN(dIn.getTime()) || isNaN(dOut.getTime())) {
          return alert("One of the selected dates is invalid. Please use the date picker.");
        }

        if (dIn < now) {
          return alert("Check-in date cannot be in the past!");
        }

        if (dOut <= dIn) {
          return alert("Check-out date must be after check-in date!");
        }

        // Max date check (2 years)
        const maxD = new Date();
        maxD.setFullYear(maxD.getFullYear() + 2);
        if (dIn > maxD || dOut > maxD) {
          return alert("Booking dates cannot be more than 2 years in the future.");
        }

        socket.emit("make_offer", {
          listingId,
          guestId,
          offeredPrice: price,
          username: myUsername,
          userId: myUserId,
          checkIn,
          checkOut,
        });

        document.getElementById("offerOverlay").classList.remove("show");
      }

      socket.on("offer_made", ({ offerId, offeredPrice, username, checkIn, checkOut }) => {
        const mine = username === myUsername;
        if (mine) myActiveOfferId = offerId;

        const card = document.createElement("div");
        card.className = `chat-offer-card ${mine ? "mine" : ""}`;
        card.id = `offer-${offerId}`;
        card.innerHTML = `
      <div class="d-flex justify-content-between align-items-start">
        <b>${mine ? "My Proposal" : `Proposal from ${username}`}</b>
        <span class="badge bg-warning text-dark rounded-pill" style="font-size:0.7rem">Pending</span>
      </div>
      <div class="my-2">
        💰 <b>₹${Number(offeredPrice).toLocaleString("en-IN")}</b> (Total inclusive price)<br>
        📅 <small>${checkIn} → ${checkOut}</small>
      </div>
      ${currentUserIsHost && !mine ? `
        <div style="margin-top:.6rem; display:flex; gap:.5rem;">
          <button class="btn-send" style="padding:.35rem .9rem" onclick="acceptOffer('${offerId}')">✅ Accept</button>
          <button class="btn-offer" style="padding:.35rem .9rem" onclick="rejectOffer('${offerId}')">❌ Reject</button>
        </div>` : ""}
    `;
        chatBox.appendChild(card);
        scrollBottom();
      });

      function acceptOffer(offerId) {
        socket.emit("accept_offer", { listingId, guestId, offerId, hostId: myUserId });
      }

      function rejectOffer(offerId) {
        socket.emit("reject_offer", { listingId, guestId, offerId });
      }

      socket.on("offer_accepted", ({ offerId, checkoutUrl, offeredPrice }) => {
        const card = document.getElementById(`offer-${offerId}`);
        if (card) {
          const badge = card.querySelector(".badge");
          if (badge) {
            badge.className = "badge bg-success rounded-pill";
            badge.textContent = "Accepted";
          }
          // Remove buttons immediately on status change
          const btnGroup = card.querySelector("div[style*='display:flex']");
          if (btnGroup) btnGroup.remove();
        }

        // ONLY show the banner to the Guest
        if (!currentUserIsHost) {
          const banner = document.getElementById("acceptedBanner");
          const checkoutLink = document.getElementById("checkoutLink");
          if (checkoutLink) checkoutLink.href = checkoutUrl;
          if (banner) banner.classList.add("show");
          scrollBottom();
        }
      });

      socket.on("offer_rejected", ({ offerId }) => {
        const card = document.getElementById(`offer-${offerId}`);
        if (card) {
          const badge = card.querySelector(".badge");
          if (badge) {
            badge.className = "badge bg-danger rounded-pill";
            badge.textContent = "Rejected";
          }
          card.style.opacity = "0.7";
          // Remove buttons immediately on status change
          const btnGroup = card.querySelector("div[style*='display:flex']");
          if (btnGroup) btnGroup.remove();
        }
      });
    </script>