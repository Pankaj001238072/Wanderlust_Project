<% layout("/layouts/boilerplate") %>

  <script>
    const mapToken = "<%= mapToken %>";
    const listing = <%- JSON.stringify(listing) %>;
    const unavailableDateRanges = <%- JSON.stringify(bookedDateRanges || []) %>;
  </script>

  <div class="row mt-3 show-page-row">

    <div class="col-12 col-lg-8 offset-lg-2 show-main-col">
      <h3>
        <%= listing.title %>
      </h3>
    </div>

    <div class="card col-12 col-lg-8 offset-lg-2 show-card listing-card show-listing-card">

      <div class="show-img-wrapper" style="position: relative;">
        <!-- ❤️ Wishlist Button -->
        <button
          class="wishlist-btn <%= typeof isWishlisted !== 'undefined' && isWishlisted ? 'active' : '' %>"
          onclick="event.stopPropagation(); toggleHeart(event, this)" data-id="<%= listing._id %>"
          style="top: 20px; right: 20px; width: 36px; height: 36px; font-size: 1rem;">
          <i
            class="<%= typeof isWishlisted !== 'undefined' && isWishlisted ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>"></i>
        </button>
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image" />
      </div>

      <div class="card-body">

        <p class="card-text">
          Owned by
          <i>
            <%= listing.owner && listing.owner.username ? listing.owner.username : "Unknown host" %>
          </i>
        </p>

        <p class="card-text">
          <%= listing.description %>
        </p>

        <p class="card-text">
          &#8377; <%= listing.price.toLocaleString("en-IN") %>
        </p>

        <p class="card-text">
          <%= listing.location %>
        </p>

        <p class="card-text">
          <%= listing.country %>
        </p>

        <p class="card-text mb-1">
          <b>Capacity:</b>
          <%= listing.maxGuests ?? 4 %>
            guests,
            <%= listing.maxKids ?? 2 %>
              kids,
              <%= (listing.maxPets ?? 0)> 0 ? `${listing.maxPets} pets` : "pets not allowed" %>
        </p>

        <p class="card-text mb-0">
          <b>Pricing policy:</b>
          <% if ((listing.extraGuestFeePerNight ?? 0)> 0) { %>
            Base <%= listing.baseGuests ?? 2 %> incl. +₹<%= (listing.extraGuestFeePerNight ?? 0).toLocaleString("en-IN")
                %>/extra guest/night (max <%= listing.maxGuests ?? 4 %>).
                  <% } else { %>
                    Up to <%= listing.maxGuests ?? 4 %> guests included.
                      <% } %>
        </p>

      </div>

    </div>


    <% if (currUser && listing.owner && listing.owner._id && String(currUser._id)===String(listing.owner._id)) { %>

      <div class="col-12 col-lg-8 offset-lg-2 show-main-col">

        <div class="show-action-btns">

          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">
            Edit
          </a>

          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE"
            data-confirm="Are you sure you want to delete this listing? This action cannot be undone.">
            <button type="submit" class="btn btn-dark">Delete</button>
          </form>

        </div>

      </div>

      <% } %>


        <div class="col-12 col-lg-8 offset-lg-2 mb-0 show-main-col">

          <%- include("./bookingSection.ejs") %>


            <% if(currUser) { %>

              <h4>Leave a Review</h4>

              <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">

                <div class="mb-0 mt-2">

                  <label for="rating" class="form-label">Rating</label>

                  <fieldset class="starability-slot">

                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                      aria-label="No rating." />

                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>

                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>

                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>

                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>

                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>

                  </fieldset>
                </div>

                <div class="mb-3 mt-0">
                  <label for="comment" class="form-label comment-label">
                    Comments
                  </label>

                  <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"
                    required></textarea>

                  <div class="invalid-feedback">
                    Please add some comments for review
                  </div>

                </div>

                <button type="submit" class="btn btn-outline-dark">
                  Submit
                </button>

              </form>
              <hr />
              <% } %>


                <% if(listing.reviews.length> 0) { %>
                  <div class="row reviews-row">
                    <p><b>All Reviews</b></p>
                    <% for (review of listing.reviews) { %>
                      <div class="card col-12 col-md-6 mb-3 review-card">
                        <div class="card-body">
                          <h5 class="card-title">
                            @<%= review.author && review.author.username ? review.author.username : "deleted-user" %>
                          </h5>

                          <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>

                          <p class="card-text">
                            <%= review.comment %>
                          </p>

                          <% if (currUser && review.author && review.author._id &&
                            String(currUser._id)===String(review.author._id)) { %>

                            <form class="mb-3" method="POST"
                              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                              data-confirm="Are you sure you want to delete this review?">
                              <button type="submit" class="btn btn-sm btn-dark mb-2">
                                Delete
                              </button>
                            </form>

                            <% } %>

                        </div>

                      </div>

                      <% } %>

                  </div>

                  <% } %>

        </div>

        <div class="col-12 col-lg-8 offset-lg-2 mb-4 show-main-col">

          <h3>Where you'll be</h3>

          <div class="map-container position-relative rounded overflow-hidden" style="height: 400px; width: 100%; background: #f8f9fa;">
            <!-- Map Loader Skeleton -->
            <div id="map-skeleton" class="position-absolute w-100 h-100 d-flex flex-column justify-content-center align-items-center text-muted" style="z-index: 1;">
              <div class="spinner-grow text-danger mb-2" role="status" style="width: 2.5rem; height: 2.5rem; opacity: 0.6">
                <span class="visually-hidden">Loading...</span>
              </div>
              <span class="fw-medium small">Loading location map...</span>
            </div>

            <!-- The Map -->
            <div id="map" class="position-absolute w-100 h-100" style="opacity: 0; transition: opacity 0.5s ease-in-out; z-index: 2;"></div>
          </div>

        </div>

  </div>


  <script defer src="/js/map.js"></script>