<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <div class="col-12 col-md-8 offset-md-2">
            <h3>Create a New Listing</h3>
            <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data"
                id="createListingForm">
                <div class="mb-3 ">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control"
                        required />
                    <div class="valid-feedback">Title looks good!</div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please enter a short description</div>
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label">Upload Listing Image</label>
                    <input name="listing[image]" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif"
                        required />
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input name="listing[price]" placeholder="1200" type="" class="form-control" required>
                        <div class="invalid-feedback">Price should be valid</div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input name="listing[country]" placeholder="India" type="text" class="form-control" required>
                        <div class="invalid-feedback">Country name should be valid</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input name="listing[location]" placeholder="Jaipur, Rajasthan" type="text" class="form-control"
                        required>
                    <div class="invalid-feedback">Location should be valid</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select name="listing[category]" class="form-control" required>
                        <option value="trending">Trending</option>
                        <option value="rooms">Rooms</option>
                        <option value="iconic">Iconic Cities</option>
                        <option value="mountains">Mountains</option>
                        <option value="castles">Castles</option>
                        <option value="pools">Amazing Pools</option>
                        <option value="camping">Camping</option>
                        <option value="farms">Farms</option>
                        <option value="arctic">Arctic</option>
                        <option value="domes">Domes</option>
                        <option value="boats">Boats</option>
                    </select>
                </div>

                <%- include("../includes/hostPolicyCard.ejs", { baseGuests: 2, maxGuests: 4, maxKids: 2, maxInfants: 0,
                    maxPets: 0, extraGuestFeePerNight: 0, }) %>

                <!-- 🎯 Fixed Add-on Services with Dynamic Prices -->
                <div class="card p-3 mb-3 shadow-sm border-0 mt-3" style="background: #f8f9fa; border-radius: 14px;">
                    <h5 class="mb-2" style="font-weight: 700;">🎁 Add-on Services & Experiences</h5>
                    <p class="text-muted small mb-3">Enable services and set your own prices for this property.</p>
                    
                    <div id="addons-container">
                        <% 
                            const services = [
                                { name: "Airport Pickup", sub: "Host will coordinate via chat", icon: "🚖", type: "fixed" },
                                { name: "Bonfire Setup", sub: "Evening bonfire experience", icon: "🔥", type: "fixed" },
                                { name: "Local Food Experience", sub: "Authentic local flavors", icon: "🍛", type: "per_person" }
                            ];
                        %>

                        <% services.forEach((service, i) => { %>
                            <div class="addon-row d-flex align-items-center gap-3 mb-3 pb-3 border-bottom flex-wrap">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input addon-toggle" type="checkbox" id="toggle-<%= i %>" 
                                           style="cursor:pointer; width: 2.5rem; height: 1.25rem;">
                                </div>
                                <div class="flex-grow-1" style="min-width: 200px;">
                                    <div class="fw-bold d-flex align-items-center gap-2">
                                        <span><%= service.icon %></span> <%= service.name %>
                                    </div>
                                    <small class="text-muted d-block"><%= service.sub %></small>
                                </div>
                                <div class="addon-price-input-wrapper d-flex align-items-center gap-2" style="opacity: 0.5; pointer-events: none;">
                                    <span class="small fw-bold text-muted">₹</span>
                                    <input type="number" name="listing[addOns][<%= i %>][price]" 
                                           class="form-control form-control-sm" 
                                           placeholder="Price" style="width: 100px;" disabled>
                                    <% if(service.type === 'per_person') { %>
                                        <small class="text-muted">/person</small>
                                    <% } %>
                                    <input type="hidden" name="listing[addOns][<%= i %>][name]" value="<%= service.name %>" disabled>
                                    <input type="hidden" name="listing[addOns][<%= i %>][icon]" value="<%= service.icon %>" disabled>
                                    <input type="hidden" name="listing[addOns][<%= i %>][type]" value="<%= service.type %>" disabled>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        const toggles = document.querySelectorAll('.addon-toggle');
                        toggles.forEach(toggle => {
                            toggle.addEventListener('change', function() {
                                const wrapper = this.closest('.addon-row').querySelector('.addon-price-input-wrapper');
                                const inputs = wrapper.querySelectorAll('input');
                                if(this.checked) {
                                    wrapper.style.opacity = '1';
                                    wrapper.style.pointerEvents = 'auto';
                                    inputs.forEach(input => {
                                        input.disabled = false;
                                        if(input.type === 'number') input.required = true;
                                    });
                                } else {
                                    wrapper.style.opacity = '0.5';
                                    wrapper.style.pointerEvents = 'none';
                                    inputs.forEach(input => {
                                        input.disabled = true;
                                        if(input.type === 'number') input.required = false;
                                    });
                                }
                            });
                        });
                    });
                </script>

                    <button class="btn btn-dark add-btn mb-3" id="addListingBtn" type="submit">Add</button>
                    <a href="/listings" class="btn btn-dark mb-3 ms-2">Cancel</a>
            </form>
        </div>
    </div>

    <script src="/js/host-policy.js"></script>