<% layout("/layouts/boilerplate") %>

<div class="row mt-3 login-page">
  <div class="col-12 col-md-6 offset-md-3 login-card">

    <div class="auth-brand text-center">
      <i class="fa-solid fa-compass"></i>
      <span>Wanderlust</span>
    </div>

    <h2 class="auth-title text-center">Check your email</h2>
    <p class="auth-sub text-center">
      We sent a 6-digit code to your email. Enter it below to continue.
      It expires in <strong>10 minutes</strong>.
    </p>

    <!-- OTP form -->
    <form action="/forgot-password/verify" method="POST" id="otpForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="otp" id="otpHidden">

      <div class="otp-boxes" id="otpBoxes">
        <% for(let i = 0; i < 6; i++) { %>
          <input type="text"
                 class="otp-box"
                 maxlength="1"
                 inputmode="numeric"
                 pattern="[0-9]"
                 autocomplete="one-time-code"
                 aria-label="Digit <%= i+1 %>" />
        <% } %>
      </div>

      <button class="btn auth-btn w-100 mt-3" id="verifyBtn" disabled>
        <i class="fa-solid fa-key"></i> Continue
      </button>
    </form>

    <!-- Resend -->
    <form action="/forgot-password/resend" method="POST" class="text-center mt-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p class="auth-sub mb-1">Didn't receive the code?</p>
      <button type="submit" class="btn-resend" id="resendBtn" disabled>
        Resend Code <span id="resendCountdown">(60s)</span>
      </button>
    </form>

    <p class="auth-switch text-center">
      <a href="/forgot-password">← Use a different email</a>
    </p>

  </div>
</div>

<style>
  .otp-boxes {
    display: flex;
    justify-content: center;
    gap: clamp(6px, 2vw, 12px);
    margin: 8px 0 4px;
    width: 100%;
  }
  .otp-box {
    width: clamp(36px, 12vw, 52px);
    height: clamp(44px, 14vw, 60px);
    flex: 1 1 0;
    min-width: 0;
    max-width: 52px;
    border: 2px solid #ddd;
    border-radius: 10px;
    font-size: clamp(1.2rem, 4vw, 1.7rem);
    font-weight: 700;
    text-align: center;
    color: #222;
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
    background: #fafafa;
    padding: 0;
  }
  .otp-box:focus {
    border-color: #ff385c;
    box-shadow: 0 0 0 3px rgba(255,56,92,.15);
    background: #fff;
  }
  .otp-box.filled {
    border-color: #ff385c;
    background: #fff5f7;
  }
  @media (max-width: 340px) {
    .otp-boxes { gap: 4px; }
    .otp-box   { border-radius: 7px; }
  }
  .btn-resend {
    background: none;
    border: 1.5px solid #ff385c;
    color: #ff385c;
    font-weight: 600;
    font-size: 0.88rem;
    padding: 8px 20px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .btn-resend:not(:disabled):hover { background: #ff385c; color: #fff; }
  .btn-resend:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<script>
(function () {
  const boxes       = Array.from(document.querySelectorAll(".otp-box"));
  const hiddenInput = document.getElementById("otpHidden");
  const verifyBtn   = document.getElementById("verifyBtn");
  const resendBtn   = document.getElementById("resendBtn");
  const countdown   = document.getElementById("resendCountdown");

  function syncHidden() {
    const code = boxes.map(b => b.value).join("");
    hiddenInput.value = code;
    verifyBtn.disabled = !/^\d{6}$/.test(code);
    boxes.forEach(b => b.classList.toggle("filled", b.value !== ""));
  }

  boxes.forEach((box, idx) => {
    box.addEventListener("input", () => {
      box.value = box.value.replace(/\D/g, "").slice(-1);
      syncHidden();
      if (box.value && idx < boxes.length - 1) boxes[idx + 1].focus();
    });
    box.addEventListener("keydown", (e) => {
      if (e.key === "Backspace" && !box.value && idx > 0) {
        boxes[idx - 1].value = "";
        boxes[idx - 1].focus();
        syncHidden();
        e.preventDefault();
      }
      if (e.key === "ArrowLeft"  && idx > 0)               boxes[idx - 1].focus();
      if (e.key === "ArrowRight" && idx < boxes.length - 1) boxes[idx + 1].focus();
    });
    box.addEventListener("paste", (e) => {
      const text = (e.clipboardData || window.clipboardData).getData("text").replace(/\D/g, "");
      if (text.length >= 6) {
        boxes.forEach((b, i) => { b.value = text[i] || ""; });
        boxes[Math.min(5, text.length - 1)].focus();
        syncHidden();
        e.preventDefault();
      }
    });
  });

  boxes[0].focus();

  document.getElementById("otpForm").addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !verifyBtn.disabled) document.getElementById("otpForm").submit();
  });

  // 60-second resend countdown
  let secs = 60;
  const timer = setInterval(() => {
    secs--;
    countdown.textContent = `(${secs}s)`;
    if (secs <= 0) {
      clearInterval(timer);
      countdown.textContent = "";
      resendBtn.disabled = false;
    }
  }, 1000);
})();
</script>
