<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">
  <div class="row">
    <div class="col-md-10 offset-md-1 col-lg-8 offset-lg-2">
      <div class="card shadow-sm border-0" style="border-radius: 24px; overflow: hidden;">
        <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
          <h2 class="fw-bold" style="color: #ff385c;">Inbox</h2>
          <p class="text-muted">Manage your price negotiations and messages.</p>
        </div>
        
        <div class="card-body p-0">
          <% if (chats && chats.length > 0) { %>
            <div class="list-group list-group-flush">
              <% chats.forEach(chat => { %>
                <% 
                  const isUserHost = String(chat.host._id) === String(currUser._id);
                  const otherUser = isUserHost ? chat.guest : chat.host;
                  const lastMsg = chat.messages[chat.messages.length - 1];
                  const isUnread = isUserHost ? chat.unreadByHost : chat.unreadByGuest;
                %>
                <a href="/listings/<%= chat.listing._id %>/chat/<%= chat.guest._id %>" 
                   class="list-group-item list-group-item-action py-4 px-4 d-flex align-items-center border-0 border-bottom chat-item <%= isUnread ? 'bg-unread' : '' %>">
                  
                  <!-- Listing Thumbnail -->
                  <div class="me-3 position-relative">
                    <img src="<%= chat.listing.image.url %>" class="rounded-3" 
                         style="width: 70px; height: 70px; object-fit: cover;">
                    <img src="<%= (otherUser.photo && otherUser.photo.url) ? otherUser.photo.url : 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>" 
                         class="rounded-circle border border-white" 
                         style="width: 25px; height: 25px; position: absolute; bottom: -5px; right: -5px; object-fit: cover;">
                  </div>

                  <!-- Chat Info -->
                  <div class="flex-grow-1 overflow-hidden">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <div class="d-flex align-items-center">
                        <h6 class="mb-0 <%= isUnread ? 'fw-bold' : 'fw-medium' %> text-dark"><%= chat.listing.title %></h6>
                        <% if (isUnread) { %>
                          <span class="ms-2" style="width: 8px; height: 8px; background-color: #0084ff; border-radius: 50%; display: inline-block;" title="New message"></span>
                        <% } %>
                      </div>
                      <small class="<%= isUnread ? 'fw-bold text-primary' : 'text-muted' %>"><%= new Date(chat.lastUpdated).toLocaleDateString() %></small>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                      <p class="mb-0 <%= isUnread ? 'text-dark fw-bold' : 'text-muted' %> text-truncate small" style="max-width: 80%;">
                        <b><%= otherUser.username %>:</b> <%= lastMsg ? (lastMsg.type === 'offer' ? 'Sent an offer' : lastMsg.text) : 'Started a conversation' %>
                      </p>
                      <% if (isUserHost) { %>
                        <span class="badge bg-light text-dark border rounded-pill py-1 px-2" style="font-size: 0.65rem;">Hosting</span>
                      <% } %>
                    </div>
                  </div>

                  <div class="ms-3">
                    <i class="fa-solid fa-chevron-right text-muted opacity-50"></i>
                  </div>
                </a>
              <% }) %>
            </div>
          <% } else { %>
            <div class="text-center py-5 px-4">
              <div class="mb-4">
                <i class="fa-regular fa-comments text-muted opacity-25" style="font-size: 5rem;"></i>
              </div>
              <h4 class="text-dark fw-bold">No messages yet</h4>
              <p class="text-muted mx-auto" style="max-width: 300px;">
                When you start negotiating with hosts or receive offers from guests, they'll appear here.
              </p>
              <a href="/listings" class="btn btn-outline-danger rounded-pill px-4 mt-3">Start Exploring</a>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .chat-item {
    transition: background-color 0.2s, transform 0.1s;
  }
  .chat-item:hover {
    background-color: #f8f9fa !important;
  }
  .chat-item:active {
    transform: scale(0.99);
  }
  .bg-unread {
    background-color: #f0f7ff !important;
    border-left: 4px solid #0084ff !important;
  }
  .text-truncate {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
