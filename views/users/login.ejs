<% layout("/layouts/boilerplate") %>

<div class="row mt-3 login-page">
  <div class="col-12 col-md-6 offset-md-3 login-card">

    <div class="auth-brand text-center">
      <i class="fa-solid fa-compass"></i>
      <span>Wanderlust</span>
    </div>

    <h2 class="auth-title text-center">Welcome back</h2>
    <p class="auth-sub text-center">
      Log in to access your stays, bookings & wishlist
    </p>

    <form action="/login" method="POST" class="needs-validation" novalidate>

      <!-- Username -->
      <div class="mb-3">
        <label class="form-label">Username</label>
        <div class="input-wrap">
          <i class="fa-regular fa-user"></i>
          <input name="username" type="text" class="form-control"
            placeholder="Your username" required />
        </div>
      </div>

      <!-- Password -->
      <div class="mb-3">
        <label class="form-label">Password</label>
        <div class="input-wrap">
          <i class="fa-solid fa-lock"></i>
          <input name="password" id="password" type="password" class="form-control"
            placeholder="Your password" required />
          <i class="fa-regular fa-eye-slash toggle-password" id="togglePassword"></i>
        </div>
      </div>

      <button class="btn auth-btn w-100">
        <i class="fa-solid fa-right-to-bracket"></i> Log in
      </button>

    </form>

    <p class="auth-switch text-center">
      Don't have an account? <a href="/signup">Sign up</a>
    </p>

  </div>
</div>