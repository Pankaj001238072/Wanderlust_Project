<% layout("/layouts/boilerplate") %>

<div class="row mt-3 login-page">
  <div class="col-12 col-md-6 offset-md-3 login-card">

    <div class="auth-brand text-center">
      <i class="fa-solid fa-compass"></i>
      <span>Wanderlust</span>
    </div>

    <h2 class="auth-title text-center">Forgot Password</h2>
    <p class="auth-sub text-center">
      Enter your <strong>username</strong> or <strong>email</strong> and we'll send a reset code.
    </p>

    <form action="/forgot-password" method="POST" class="needs-validation" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label class="form-label">Email</label>
        <div class="input-wrap">
          <i class="fa-regular fa-user"></i>
          <input name="identifier" type="text" class="form-control"
            placeholder="Your email" required
            autocapitalize="none" autocorrect="off" spellcheck="false" />
        </div>
      </div>

      <button class="btn auth-btn w-100" id="forgotPasswordBtn">
        <i class="fa-solid fa-paper-plane"></i> Send Code
      </button>
    </form>

    <p class="auth-switch text-center">
      Remembered it? <a href="/login">Log in</a>
    </p>

  </div>
</div>
