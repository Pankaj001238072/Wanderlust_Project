<% layout("/layouts/boilerplate") %>

    <div class="row mt-2 mb-4 checkout-wrapper">
        <div class="col-lg-10 offset-lg-1">
            <h3 class="mb-1 text-center">Complete your payment</h3>
            <p class="text-muted mb-3 text-center">Review your booking details and finish payment securely.</p>

            <div class="row g-3 checkout-columns">
                <div class="col-lg-5">
                    <% if (typeof isLastMinute !== 'undefined' && isLastMinute) { %>
                    <div class="alert alert-warning py-2 mb-3 border-0 shadow-sm" style="background: #fff4e6; color: #d9480f; font-size: 0.85rem; border-radius: 12px;">
                        <i class="fa-solid fa-bolt-lightning me-1"></i>
                        <b>Urgent Stay:</b> Since your stay is for today, please complete payment quickly to secure your dates!
                    </div>
                    <% } %>

                    <div class="card checkout-summary-card">
                        <% if (listing.image && listing.image.url) { %>
                            <img src="<%= listing.image.url %>" class="card-img-top checkout-summary-img"
                                alt="listing image" />
                            <% } %>
                                <div class="card-body p-3 p-md-4">
                                    <h5 class="fw-bold mb-3 border-bottom pb-2">Booking Summary</h5>
                                    <h5 class="mb-2 text-muted fw-bold">
                                        <i class="fa-solid fa-house-chimney me-1"></i> <%= listing.title %>
                                    </h5>
                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-1 fw-bold">Booking Dates:</small>
                                        <div class="checkout-summary-row">
                                            <span>Check-in</span>
                                            <b>
                                                <%= new Date(checkInDate).toLocaleDateString("en-IN") %>
                                            </b>
                                        </div>
                                        <div class="checkout-summary-row">
                                            <span>Check-out</span>
                                            <b>
                                                <%= new Date(checkOutDate).toLocaleDateString("en-IN") %>
                                            </b>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3 pb-2 border-bottom">
                                        <small class="text-muted d-block mb-1 fw-bold">Booking Times:</small>
                                        <div class="checkout-summary-row flex-wrap mb-1">
                                            <span class="text-muted small"><i class="fa-solid fa-clock me-1"></i> Check-in</span>
                                            <b class="fw-bold small">1:00 PM</b>
                                        </div>
                                        <div class="checkout-summary-row flex-wrap">
                                            <span class="text-muted small"><i class="fa-solid fa-clock me-1"></i> Check-out</span>
                                            <b class="fw-bold small">11:00 AM</b>
                                        </div>
                                    </div>
                                    <div class="checkout-summary-row">
                                        <span>Nights</span>
                                        <b>
                                            <%= numberOfNights %>
                                        </b>
                                    </div>
                                    <div class="checkout-summary-row">
                                        <span>People</span>
                                        <b>
                                            <%= people %>
                                        </b>
                                    </div>
                                    <div class="checkout-summary-row">
                                        <span>Kids</span>
                                        <b>
                                            <%= kids %>
                                        </b>
                                    </div>
                                    <div class="checkout-summary-row">
                                        <span>Infants</span>
                                        <b>
                                            <%= infants ?? 0 %>
                                        </b>
                                    </div>
                                    <div class="checkout-summary-row">
                                        <span>Pets</span>
                                        <b>
                                            <%= pets %>
                                        </b>
                                    </div>
                                    <% if (extraGuestCount> 0 && extraGuestFeePerNight > 0) { %>
                                        <div class="checkout-summary-row">
                                            <span>Extra guest charge</span>
                                            <b>
                                                ₹ <%= Number(extraGuestCharge || 0).toLocaleString("en-IN") %>
                                            </b>
                                        </div>
                                        <small class="text-muted d-block mb-2">
                                            <%= extraGuestCount %> extra guest x ₹ <%= Number(extraGuestFeePerNight ||
                                                    0).toLocaleString("en-IN") %> per night x <%= numberOfNights %>
                                                        nights
                                        </small>
                                        <% } %>

                                            <% if (typeof pricingBreakdown !=='undefined' && pricingBreakdown.length> 0)
                                                { %>
                                                <div class="mt-2 mb-2 pt-2 border-top border-bottom pb-2">
                                                    <small class="text-muted d-block mb-1"><i
                                                            class="fa-solid fa-bolt text-warning me-1"></i> Dynamic
                                                        Pricing Applied:</small>
                                                    <% pricingBreakdown.forEach(item=> { %>
                                                        <div class="checkout-summary-row text-<%= item.color %> mb-0"
                                                            style="font-size: 0.9rem;">
                                                            <span>
                                                                <%= item.label %>
                                                            </span>
                                                            <b>
                                                                <%= item.change %>
                                                            </b>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                                <% } %>

                                                    <div class="checkout-summary-row mt-2">
                                                        <span>Subtotal</span>
                                                        <b>
                                                            ₹ <%= Number(subtotal).toLocaleString("en-IN") %>
                                                        </b>
                                                    </div>
                                                    <% if (typeof offerDiscount !=='undefined' && offerDiscount> 0) { %>
                                                        <div class="checkout-summary-row text-success fw-bold">
                                                            <span>Special Offer (-<%= offerPercent %>%)</span>
                                                            <b>
                                                                -₹ <%= Number(offerDiscount).toLocaleString("en-IN") %>
                                                            </b>
                                                        </div>
                                                        <% } %>
                                                            <% const finalOfferDiscount=(typeof offerDiscount
                                                                !=='undefined' ) ? Number(offerDiscount) : 0; const
                                                                gstAmount=totalPrice - (subtotal - finalOfferDiscount);
                                                                %>
                                                                <% if (gstAmount> 0) { %>

                                                                    <div class="checkout-summary-row mt-2 flex-wrap">
                                                                        <span class="small">Total for <%= numberOfNights %> nights</span>
                                                                        <b class="small">₹ <%= (subtotal - finalOfferDiscount).toLocaleString("en-IN") %></b>
                                                                    </div>
                                                                    <div class="checkout-summary-row text-muted"
                                                                        style="font-size: 0.9rem;">
                                                                        <span>Taxes & Fees (18% GST)</span>
                                                                        <b>₹ <%= Number(gstAmount).toLocaleString("en-IN")
                                                                                %></b>
                                                                    </div>
                                                                    <% } %>

                                                                        <div id="selected-addons-summary"
                                                                            class="mt-2 pt-2 border-top"
                                                                            style="display: none;">
                                                                            <small
                                                                                class="text-muted d-block mb-1">Selected
                                                                                Services:</small>
                                                                            <div id="addons-list-container"></div>
                                                                        </div>

                                                                        <div id="coins-summary-row" class="checkout-summary-row text-warning fw-bold mt-2" style="display: none; font-size: 0.95rem;">
                                                                            <span><i class="fa-solid fa-coins me-1"></i> WanderCoins Redeemed</span>
                                                                            <b id="coins-discount-display">-₹0</b>
                                                                        </div>

                                                                        <div
                                                                            class="checkout-summary-row border-0 mb-0 pb-0 mt-2 pt-2 border-top">
                                                                            <span>Total</span>
                                                                            <b id="display-total-price">₹ <%=
                                                                                    totalPrice.toLocaleString("en-IN")
                                                                                    %></b>
                                                                        </div>
                                                                        


                                                                        <small class="text-muted d-block mt-3">
                                                                            <i class="fa-solid fa-lock me-1"></i>
                                                                            Secure payment powered by Stripe.
                                                                        </small>
                                </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="card checkout-payment-card shadow-sm border-0">
                        <div class="card-body p-3 p-md-4">
                            <!-- 🎯 Local Experiences & Services -->
                            <% if (listing.addOns && listing.addOns.length > 0) { %>
                                <div class="mb-4">
                                    <h6 class="fw-bold mb-3"><i class="fa-solid fa-star text-warning me-2"></i> Enhance
                                        Your Stay (Optional)</h6>
                                    <div class="row g-2">
                                        <% listing.addOns.forEach((addon, index)=> { %>
                                            <div class="col-12">
                                                <div class="addon-card p-2 rounded d-flex align-items-center"
                                                    style="background: #fdfdfd; border: 1px solid #eee; transition: all 0.2s; min-height: 65px;">
                                                    <div class="form-check mb-0 d-flex align-items-center w-100 flex-nowrap">
                                                        <input class="form-check-input addon-checkbox me-2"
                                                            type="checkbox" id="addon-<%= index %>"
                                                            data-price="<%= addon.price %>"
                                                            data-name="<%= addon.name %>"
                                                            data-type="<%= addon.type || (addon.name.toLowerCase().includes('food') ? 'per_person' : 'fixed') %>"
                                                            style="width: 1.1rem; height: 1.1rem; cursor: pointer; flex-shrink: 0;">
                                                        <label
                                                            class="form-check-label d-flex align-items-center flex-grow-1 overflow-hidden"
                                                            for="addon-<%= index %>" style="cursor: pointer; gap: 8px;">
                                                            <span class="fs-4 flex-shrink-0" style="min-width: 32px; text-align: center;">
                                                                <%= addon.icon %>
                                                            </span>
                                                                <div class="me-auto overflow-hidden">
                                                                    <div class="fw-bold" style="font-size: 0.9rem; line-height: 1.2;">
                                                                        <%= addon.name %>
                                                                    </div>
                                                                    <small class="text-muted d-block mt-1" style="font-size: 0.75rem; line-height: 1.2;"><%= addon.sub || "Professional service" %></small>
                                                                </div>
                                                                <div class="fw-bold text-dark flex-shrink-0 ms-2" style="font-size: 0.9rem; text-align: right;">
                                                                    +₹<%= addon.price.toLocaleString("en-IN") %>
                                                                    <% if(addon.type === 'per_person' || addon.name.toLowerCase().includes('food')) { %>
                                                                        <div class="text-muted" style="font-size: 0.65rem; font-weight: normal; margin-top: -2px;">/person</div>
                                                                    <% } %>
                                                                </div>
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <div class="alert alert-info py-2 px-3 mt-2" style="font-size: 0.75rem; border-radius: 10px;">
                                        <i class="fa-solid fa-circle-info me-1"></i>
                                        For <b>Airport Pickup</b>, our host will contact you via <b>In-app Chat</b> to collect your flight details after booking.
                                    </div>
                                </div>
                            <% } %>

                                <h5 class="mb-1" style="font-weight: 700;">Card details</h5>
                                <p class="text-muted mb-3" style="font-size: 0.85rem;">Enter card details to complete
                                    your
                                    secure payment.</p>

                                <!-- Wallet Coins -->
                                <% if (typeof walletBalance !=='undefined' && walletBalance> 0) { %>
                                    <% const maxCoinsToUse=Math.min(walletBalance, Math.floor(totalPrice * 0.20)); %>
                                        <div class="d-flex align-items-center mb-3 p-2 rounded"
                                            style="background: #fff3cd; border: 1px dashed #ffe69c;">
                                            <div class="form-check mb-0 d-flex align-items-center w-100">
                                                <input class="form-check-input me-2" type="checkbox" id="useCoinsToggle"
                                                    style="cursor: pointer;" data-max-coins="<%= maxCoinsToUse %>">
                                                <label class="form-check-label small fw-bold me-auto text-dark"
                                                    for="useCoinsToggle" style="cursor: pointer;">
                                                    🪙 Use WanderCoins (Balance: <%= walletBalance %>)
                                                </label>
                                                <span class="badge bg-warning text-dark ms-2">-₹<span
                                                        id="coinDiscountAmount">
                                                        <%= maxCoinsToUse %>
                                                    </span></span>
                                            </div>
                                        </div>
                                        <% } %>

                                            <!-- Split Payment Choice -->
                                            <div class="d-flex align-items-center mb-4 p-2 rounded"
                                                style="background: #f8f9fa; border: 1px dashed #ced4da;">
                                                <div class="form-check mb-0 d-flex align-items-center w-100">
                                                    <input class="form-check-input me-2" type="checkbox"
                                                        id="splitToggle" style="cursor: pointer;">
                                                    <label class="form-check-label small fw-bold me-auto"
                                                        for="splitToggle" style="cursor: pointer; color: #444;">
                                                        👥 Split with friends
                                                    </label>
                                                    <select id="splitWays"
                                                        class="form-select form-select-sm w-auto ms-2"
                                                        style="display: none;">
                                                        <option value="2">2 People</option>
                                                        <option value="3">3 People</option>
                                                        <option value="4">4 People</option>
                                                        <option value="5">5 People</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <form id="payment-form">
                                                <div id="payment-element" style="min-height: 200px;">
                                                    <div id="stripe-loading" class="text-center py-4 text-muted small">
                                                        Loading secure card fields...
                                                    </div>
                                                </div>
                                                <button id="submit-payment"
                                                    class="btn btn-dark mt-3 w-100 py-2 fw-bold btn-pay-hover"
                                                    style="background-color: #1a1a1a; border: none; transition: background-color 0.2s ease, border-color 0.2s ease;">
                                                    <span class="submit-label">Pay ₹ <%=
                                                            totalPrice.toLocaleString("en-IN") %></span>
                                                </button>
                                                <div id="payment-message" class="text-danger mt-2 small"></div>
                                            </form>
                                            <form method="POST"
                                                action="/bookings/payment/cancel/<%= listing._id %>?payment_intent=<%= paymentIntentId %>">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                                <button type="submit"
                                                    class="btn btn-outline-secondary mt-2 w-100">Cancel
                                                    and go
                                                    back</button>
                                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://js.stripe.com/v3/"></script>
    <script>
        (() => {
            const stripe = Stripe("<%= publishableKey %>");
            const clientSecret = "<%= clientSecret %>";
            const fullAmount = Number("<%= totalPrice %>") || 0;
            const splitAmount = Math.ceil(fullAmount / 2);
            const elements = stripe.elements({ clientSecret });
            const paymentElement = elements.create("payment");

            paymentElement.on('change', function (event) {
                const messageContainer = document.getElementById("payment-message");
                if (messageContainer) {
                    if (event.error) {
                        messageContainer.textContent = event.error.message;
                    } else {
                        messageContainer.textContent = "";
                    }
                }
            });

            const form = document.getElementById("payment-form");
            const submitButton = document.getElementById("submit-payment");
            const splitToggle = document.getElementById("splitToggle");
            const splitWaysSelect = document.getElementById("splitWays");
            const useCoinsToggle = document.getElementById("useCoinsToggle");

            const mountStripe = async () => {
                const loader = document.getElementById("stripe-loading");
                const el = document.getElementById("payment-element");
                if (!el) return;
                try {
                    if (el.innerHTML.trim() !== "" && !loader) return;
                    await paymentElement.mount("#payment-element");
                    if (loader) loader.style.display = "none";
                } catch (e) { console.log("Mount issue handled"); }
            };

            const addonCheckboxes = document.querySelectorAll(".addon-checkbox");

            const updateButtonText = async () => {
                const label = submitButton.querySelector('.submit-label');
                if (label && splitToggle && splitWaysSelect) {
                    const isSplit = splitToggle.checked;
                    splitWaysSelect.style.display = isSplit ? 'inline-block' : 'none';

                    const isUsingCoins = useCoinsToggle && useCoinsToggle.checked;
                    const maxCoins = isUsingCoins ? parseInt(useCoinsToggle.dataset.maxCoins) : 0;

                    // Add-ons Calculation
                    let addonsTotal = 0;
                    let selectedAddons = [];
                    const addonsSummaryContainer = document.getElementById("selected-addons-summary");
                    const addonsListContainer = document.getElementById("addons-list-container");

                    if (addonsListContainer) addonsListContainer.innerHTML = "";

                    addonCheckboxes.forEach(cb => {
                        if (cb.checked) {
                            let price = parseInt(cb.dataset.price);
                            const name = cb.dataset.name;
                            const type = cb.dataset.type;
                            
                            // If per person, multiply by total guests
                            if(type === 'per_person') {
                                const totalGuests = parseInt("<%= people %>") + parseInt("<%= kids %>");
                                price = price * totalGuests;
                            }

                            addonsTotal += price;
                            selectedAddons.push({
                                name: name,
                                price: price,
                                icon: cb.parentElement.querySelector('.fs-4').textContent
                            });

                            // Add to left summary
                            if (addonsListContainer) {
                                const row = document.createElement("div");
                                row.className = "checkout-summary-row text-primary mb-0";
                                row.style.fontSize = "0.85rem";
                                row.innerHTML = `<span>${name}</span> <b>+₹${price.toLocaleString("en-IN")}</b>`;
                                addonsListContainer.appendChild(row);
                            }
                        }
                    });

                    if (addonsSummaryContainer) {
                        addonsSummaryContainer.style.display = selectedAddons.length > 0 ? "block" : "none";
                    }

                    const adjustedFullAmount = fullAmount + addonsTotal - maxCoins;
                    const splitWays = isSplit ? parseInt(splitWaysSelect.value) : 1;
                    const amountToPay = isSplit ? Math.ceil(adjustedFullAmount / splitWays) : adjustedFullAmount;

                    label.textContent = isSplit
                        ? `Pay My Share (₹ ${amountToPay.toLocaleString("en-IN")})`
                        : `Pay ₹ ${amountToPay.toLocaleString("en-IN")}`;

                    // Update Coins Summary Row
                    const coinsSummaryRow = document.getElementById("coins-summary-row");
                    const coinsDisplay = document.getElementById("coins-discount-display");
                    if (coinsSummaryRow && coinsDisplay) {
                        if (maxCoins > 0) {
                            coinsSummaryRow.style.display = "flex";
                            coinsDisplay.textContent = `-₹${maxCoins.toLocaleString("en-IN")}`;
                        } else {
                            coinsSummaryRow.style.display = "none";
                        }
                    }

                    // Update Left Total
                    const leftTotal = document.getElementById("display-total-price");
                    if (leftTotal) {
                        leftTotal.textContent = `₹ ${adjustedFullAmount.toLocaleString("en-IN")}`;
                    }

                    // Update Stripe PaymentIntent Amount on Server
                    try {
                        submitButton.disabled = true;
                        const response = await fetch('/bookings/update-payment-intent', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                paymentIntentId: "<%= paymentIntentId %>",
                                mode: isSplit ? 'split' : 'full',
                                splitWays: splitWays,
                                fullAmount: fullAmount + addonsTotal,
                                coinsUsed: maxCoins,
                                selectedAddOns: selectedAddons,
                                _csrf: "<%= csrfToken %>"
                            })
                        });
                        const data = await response.json();
                        if (!data.success) console.error("Stripe Update Failed", data.error);
                    } catch (err) {
                        console.error("Network error updating intent", err);
                    } finally {
                        submitButton.disabled = false;
                    }
                }
            };

            addonCheckboxes.forEach(cb => cb.addEventListener("change", updateButtonText));

            mountStripe();
            updateButtonText();

            window.addEventListener("pageshow", (e) => {
                mountStripe();
                updateButtonText();
            });

            if (splitToggle) {
                splitToggle.addEventListener('change', updateButtonText);
            }
            if (splitWaysSelect) {
                splitWaysSelect.addEventListener('change', updateButtonText);
            }
            if (useCoinsToggle) {
                useCoinsToggle.addEventListener('change', updateButtonText);
            }

            form.addEventListener("submit", async (event) => {
                event.preventDefault();
                submitButton.disabled = true;
                const originalLabel = submitButton.innerHTML;
                submitButton.innerHTML = "Processing...";

                const messageContainer = document.getElementById("payment-message");
                if (messageContainer) messageContainer.textContent = "";

                const isSplit = splitToggle && splitToggle.checked;
                const selectedMode = isSplit ? 'split' : 'full';
                const splitWays = isSplit && splitWaysSelect ? splitWaysSelect.value : "1";
                const isUsingCoins = useCoinsToggle && useCoinsToggle.checked;
                const coinsUsed = isUsingCoins ? parseInt(useCoinsToggle.dataset.maxCoins) : 0;

                const { error } = await stripe.confirmPayment({
                    elements,
                    confirmParams: { return_url: `${window.location.origin}/bookings/payment/success?mode=${selectedMode}&splitWays=${splitWays}&coinsUsed=${coinsUsed}` }
                });
                if (error) {
                    const messageContainer = document.getElementById("payment-message");
                    if (messageContainer) messageContainer.textContent = error.message;
                    submitButton.disabled = false;
                    submitButton.innerHTML = originalLabel;
                }
            });
        })();
    </script>

    <style>
        .btn-pay-hover:hover {
            background-color: #495057 !important;
            border-color: #495057 !important;
        }
    </style>