<% layout("/layouts/boilerplate") %>

    <div class="row mt-2 mb-4 checkout-wrapper">
        <div class="col-lg-10 offset-lg-1">
            <h3 class="mb-1 text-center">Complete your payment</h3>
            <p class="text-muted mb-3 text-center">Review your booking details and finish payment securely.</p>

            <div class="row g-3 checkout-columns">
                <div class="col-lg-5">
                    <div class="card checkout-summary-card">
                        <% if (listing.image && listing.image.url) { %>
                            <img src="<%= listing.image.url %>" class="card-img-top checkout-summary-img"
                                alt="listing image" />
                            <% } %>
                                <div class="card-body p-3 p-md-4">
                                    <h5 class="mb-3">
                                        <%= listing.title %>
                                    </h5>
                                    <div class="checkout-summary-row">
                                        <span>Check-in.</span>
                                        <b>
                                            <%= new Date(checkInDate).toLocaleDateString("en-IN") %>
                                        </b>
                                    </div>
                                    <div class="checkout-summary-row">
                                        <span>Check-out.</span>
                                        <b>
                                            <%= new Date(checkOutDate).toLocaleDateString("en-IN") %>
                                        </b>
                                    </div>
                                    <div class="checkout-summary-row">
                                        <span>Nights.</span>
                                        <b>
                                            <%= numberOfNights %>
                                        </b>
                                    </div>
                                    <div class="checkout-summary-row">
                                        <span>People.</span>
                                        <b>
                                            <%= people %>
                                        </b>
                                    </div>
                                    <div class="checkout-summary-row">
                                        <span>Kids.</span>
                                        <b>
                                            <%= kids %>
                                        </b>
                                    </div>
                                    <div class="checkout-summary-row">
                                        <span>Infants.</span>
                                        <b>
                                            <%= infants ?? 0 %>
                                        </b>
                                    </div>
                                    <div class="checkout-summary-row">
                                        <span>Pets.</span>
                                        <b>
                                            <%= pets %>
                                        </b>
                                    </div>
                                    <% if (extraGuestCount> 0 && extraGuestFeePerNight > 0) { %>
                                        <div class="checkout-summary-row">
                                            <span>Extra guest charge</span>
                                            <b>
                                                ₹ <%= Number(extraGuestCharge || 0).toLocaleString("en-IN") %>
                                            </b>
                                        </div>
                                        <small class="text-muted d-block mb-2">
                                            <%= extraGuestCount %> extra guest x ₹ <%= Number(extraGuestFeePerNight ||
                                                    0).toLocaleString("en-IN") %> per night x <%= numberOfNights %>
                                                        nights
                                        </small>
                                        <% } %>
                                            <div class="checkout-summary-row">
                                                <span>Subtotal.</span>
                                                <b>
                                                    ₹ <%= Number(subtotal || totalPrice).toLocaleString("en-IN") %>
                                                </b>
                                            </div>
                                            <div class="checkout-summary-row border-0 mb-0 pb-0">
                                                <span>Total.</span>
                                                <b>₹ <%= totalPrice.toLocaleString("en-IN") %></b>
                                            </div>
                                            <small class="text-muted d-block mt-3">
                                                <i class="fa-solid fa-lock me-1"></i>
                                                Secure payment powered by Stripe.
                                            </small>
                                </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="card checkout-payment-card">
                        <div class="card-body p-3 p-md-4">
                            <h5 class="mb-3">Card details</h5>
                            <p class="text-muted mb-3 checkout-payment-note">Enter card details to complete your secure
                                payment.</p>
                            <form id="payment-form">
                                <div id="payment-element"></div>
                                <button id="submit-payment" class="btn btn-dark mt-3 w-100">
                                    <span class="submit-label">Pay ₹ <%= totalPrice.toLocaleString("en-IN") %></span>
                                </button>
                                <div id="payment-message" class="text-danger mt-2"></div>
                            </form>
                            <form method="POST"
                                action="/bookings/payment/cancel/<%= listing._id %>?payment_intent=<%= paymentIntentId %>">
                                <button type="submit" class="btn btn-outline-secondary mt-2 w-100">Cancel and go
                                    back</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://js.stripe.com/v3/"></script>
    <script>
        (() => {
            const stripe = Stripe("<%= publishableKey %>");
            const clientSecret = "<%= clientSecret %>";

            const elements = stripe.elements({ clientSecret });
            const paymentElement = elements.create("payment");
            paymentElement.mount("#payment-element");

            const form = document.getElementById("payment-form");
            const submitButton = document.getElementById("submit-payment");
            const messageContainer = document.getElementById("payment-message");

            form.addEventListener("submit", async (event) => {
                event.preventDefault();
                submitButton.disabled = true;
                submitButton.innerHTML = "<span class='spinner-border spinner-border-sm me-2' role='status' aria-hidden='true'></span>Processing...";
                messageContainer.textContent = "";

                const { error } = await stripe.confirmPayment({
                    elements,
                    confirmParams: {
                        return_url: `${window.location.origin}/bookings/payment/success`
                    }
                });

                if (error) {
                    messageContainer.textContent = error.message || "Payment failed. Please try again.";
                    submitButton.disabled = false;
                    submitButton.innerHTML = "<span class='submit-label'>Pay ₹ <%= totalPrice.toLocaleString('en-IN') %></span>";
                }
            });
        })();
    </script>