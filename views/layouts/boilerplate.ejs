<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

  <title>Wanderlust</title>


  <!-- DNS Prefetch / Preconnect for CDNs -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="preconnect" href="https://cdn.maptiler.com" crossorigin>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">


  <!-- CSS styling -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/show.css">
  <link rel="stylesheet" href="/css/booking.css">
  <link rel="stylesheet" href="/css/contact.css">
  <link rel="stylesheet" href="/css/help.css">
  <link rel="stylesheet" href="/css/chatbot.css">


  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
    integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
    crossorigin="anonymous" referrerpolicy="no-referrer">


  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300,400,500;600&display=swap"
    rel="stylesheet">


  <!-- Rating CSS -->
  <link rel="stylesheet" href="/css/rating.css">


  <!-- MapTiler CSS + JS -->
  <link href="https://cdn.maptiler.com/maptiler-sdk-js/v2.2.0/maptiler-sdk.css" rel="stylesheet">

  <script defer src="https://cdn.maptiler.com/maptiler-sdk-js/v2.2.0/maptiler-sdk.umd.min.js"></script>


  <!-- Favicon Compass -->
  <link rel="icon" type="image/svg+xml" href='data:image/svg+xml,
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
      <circle cx="256" cy="256" r="256" fill="%23fe424d"/>
      <path fill="white" d="M362.7 149.3L328 272c-2.3 8-8.6 14.3-16.6 16.6L188.7 323.3c-13.8 3.9-26.5-8.8-22.6-22.6L200 178c2.3-8 8.6-14.3 16.6-16.6L339.3 126.7c13.8-3.9 26.5 8.8 22.6 22.6zM256 224c-17.7 0-32 14.3-32 32s14.3 32 32 32 32-14.3 32-32-14.3-32-32-32z"/>
    </svg>'>

</head>


<body>

  <%- include("../includes/navbar.ejs") %>


    <div class="container">

      <%- include("../includes/flash.ejs") %>

        <%- body %>

    </div>


    <%- include("../includes/footer.ejs") %>


      <!-- AI Chatbot Widget -->
      <button class="ai-chat-btn" id="aiChatToggleBtn" aria-label="Chat with AI">
        <i class="fa-solid fa-robot"></i>
      </button>

      <div class="ai-chat-window" id="aiChatWindow">
        <div class="ai-chat-header">
          <i class="fa-solid fa-robot"></i>
          <span>Wanderlust AI Guide</span>
        </div>
        <div class="ai-chat-body" id="aiChatBody">
          <div class="chat-bubble chat-bubble-ai">
            Hi there! I'm your Wanderlust AI guide. How can I help you plan your next trip? 🏖️
          </div>
        </div>
        <div class="ai-chat-input-container">
          <input type="text" id="aiChatInput" placeholder="Ask me anything..." autocomplete="off">
          <button id="aiChatSendBtn" aria-label="Send">
            <i class="fa-solid fa-paper-plane"></i>
          </button>
        </div>
      </div>


      <!-- Bootstrap JS -->
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>



      <!-- Confetti Library -->
      <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

      <!-- Subscription Celebration Script -->
      <% if (typeof justSubscribed !=='undefined' && justSubscribed) { %>
        <script>
          document.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
              confetti({
                particleCount: 150,
                spread: 70,
                origin: { y: 0.8 },
                zIndex: 9999
              });
            }, 500);
          });
        </script>
        <% } %>

          <script src="/js/script.js"></script>
          <script src="/js/form-submit-guard.js"></script>
          <script src="/js/chatbot.js"></script>


          <script>
            // Toggle Password Visibility
            document.addEventListener("DOMContentLoaded", () => {
              const togglePasswords = document.querySelectorAll(".toggle-password");
              togglePasswords.forEach(toggle => {
                toggle.addEventListener("click", function () {
                  const input = this.parentElement.querySelector("input");
                  if (input && input.type === "password") {
                    input.type = "text";
                    this.classList.replace("fa-eye-slash", "fa-eye");
                  } else if (input) {
                    input.type = "password";
                    this.classList.replace("fa-eye", "fa-eye-slash");
                  }
                });
              });
            });

            (() => {

              const tokenMeta = document.querySelector('meta[name="csrf-token"]');
              const csrfToken = tokenMeta ? tokenMeta.getAttribute("content") : "";

              if (!csrfToken) return;


              const isSameOriginAction = (action) => {

                if (!action) return true;

                try {

                  const actionUrl = new URL(action, window.location.origin);
                  return actionUrl.origin === window.location.origin;

                } catch (err) {

                  return true;

                }

              };


              const forms = document.querySelectorAll("form[method='POST'], form[method='post']");

              forms.forEach((form) => {

                if (!isSameOriginAction(form.getAttribute("action"))) return;


                const encType = (form.getAttribute("enctype") || "").toLowerCase();

                if (encType === "multipart/form-data") {

                  const actionValue =
                    form.getAttribute("action") ||
                    window.location.pathname + window.location.search;

                  const actionUrl = new URL(actionValue, window.location.origin);

                  actionUrl.searchParams.set("_csrf", csrfToken);

                  const relativeAction =
                    `${actionUrl.pathname}${actionUrl.search}${actionUrl.hash}`;

                  form.setAttribute("action", relativeAction);

                  return;

                }


                const hasToken = form.querySelector("input[name='_csrf']");

                if (hasToken) return;


                const input = document.createElement("input");

                input.type = "hidden";
                input.name = "_csrf";
                input.value = csrfToken;

                form.appendChild(input);

              });

            })();

          </script>

</body>

</html>