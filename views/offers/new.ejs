<% layout("/layouts/boilerplate") %>


    <div
        style="max-width: 400px; margin: 20px auto; padding: 24px; background: #fff; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
        <h2 style="text-align:center; margin-bottom:18px; color:#ff385c;">New Offer</h2>
        <form action="/offer" method="POST" id="offerForm">
            <!-- Title and Description are now auto-filled from selected listing -->
            <input type="number" name="discount" placeholder="Discount (%)" required
                style="width:100%;margin-bottom:12px;padding:8px;border-radius:4px;border:1px solid #ccc;">
            <input type="date" name="validTill" required
                style="width:100%;margin-bottom:16px;padding:8px;border-radius:4px;border:1px solid #ccc;">
            <select name="listing" required
                style="width:100%;margin-bottom:16px;padding:8px;border-radius:4px;border:1px solid #ccc;">
                <option value="">Select Listing</option>
                <% if (typeof listings !=='undefined' ) { %>
                    <% listings.forEach(listing=> { %>
                        <option value="<%= listing._id %>">
                            <%= listing.title %>
                        </option>
                        <% }) %>
                            <% } %>
            </select>
            <button type="submit" id="submitBtn"
                style="width:100%;padding:10px;border-radius:4px;background:#007bff;color:#fff;font-size:16px;border:none;font-weight:500;">Create</button>
        </form>
        <!-- Universal form-submit-guard.js now handles double submit protection -->
    </div>